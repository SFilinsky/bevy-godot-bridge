extends SceneTree
## Exercises the public API through Godot, including native and script class references.

class Provider extends Node:
	pass

func _initialize() -> void:
	_run.call_deferred()

func _run() -> void:
	var level_a := SceneRoot.new()
	var level_b := SceneRoot.new()
	root.add_child(level_a)
	root.add_child(level_b)
	var a := Provider.new()
	var b := Provider.new()
	var c := Provider.new()
	level_a.add_child(a)
	level_a.add_child(b)
	level_b.add_child(c)
	assert(NodeRegistry.register_level_instance(a))
	assert(NodeRegistry.register_level_instance(b))
	assert(NodeRegistry.register_level_instance(c))
	assert(NodeRegistry.register_level_instance(a))
	assert(NodeRegistry.find_level_instances(a, Provider).size() == 2)
	assert(NodeRegistry.find_level_instances(c, Provider) == [c])
	assert(not NodeRegistry.register_level_singleton(a))
	NodeRegistry.unregister(a)
	assert(NodeRegistry.find_level_instances(b, Provider) == [b])
	level_a.remove_child(b)
	assert(NodeRegistry.find_level_instances(level_a, Provider).is_empty())
	level_b.add_child(b)
	assert(NodeRegistry.register_level_instance(b))
	assert(NodeRegistry.find_level_instances(c, Provider).size() == 2)
	NodeRegistry.unregister(b)
	NodeRegistry.unregister(c)
	assert(NodeRegistry.register_level_singleton(c))
	assert(NodeRegistry.register_level_singleton(c))
	assert(not NodeRegistry.register_level_singleton(b))
	assert(NodeRegistry.find_level_singleton(b, Provider) == c)
	c.free()
	assert(NodeRegistry.find_level_singleton(b, Provider) == null)
	assert(NodeRegistry.register_level_singleton(b))
	# Explicit owners need not be ancestors of their providers.
	var owner_a := Node.new()
	var owner_b := Node.new()
	level_a.add_child(owner_a)
	level_a.add_child(owner_b)
	assert(NodeRegistry.register_owned_instance(a, owner_a))
	assert(NodeRegistry.register_owned_instance(b, owner_b))
	assert(NodeRegistry.find_owned_instances(owner_a, Provider) == [a])
	assert(NodeRegistry.find_owned_instances(owner_b, Provider) == [b])
	NodeRegistry.unregister(a)
	assert(NodeRegistry.register_owned_singleton(a, owner_a))
	assert(NodeRegistry.find_owned_singleton(owner_a, Provider) == a)
	# Native class references must not construct a dummy instance to discover its type.
	var native := Node.new()
	level_a.add_child(native)
	assert(NodeRegistry.register_owned_singleton(native, owner_b))
	NodeRegistry.unregister(b)
	assert(NodeRegistry.find_owned_singleton(owner_b, Node) == native)
	# Owner exit clears registrations even when a provider stays elsewhere in the tree.
	level_a.remove_child(owner_a)
	level_a.add_child(owner_a)
	assert(NodeRegistry.find_owned_singleton(owner_a, Provider) == null)
	assert(NodeRegistry.register_owned_singleton(a, owner_a))
	assert(NodeRegistry.find_owned_singleton(owner_a, Provider) == a)
	level_a.free()
	level_b.free()
	print("NodeRegistry checks passed")
	quit()
